[Unit]
Description=FuelMe UPI Creator Support Backend API
After=network.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/FuelMe/backend
ExecStart=/usr/bin/node /home/user/FuelMe/backend/src/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=FRONTEND_URL=https://kaushalboii.github.io

[Install]
WantedBy=multi-user.target
